{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"accessWidener": "${mod_id}.accesswidener",
	"authors": [
		"StarmanMine142, dungeonerr"
	],
	"contact": {
		"homepage": "${homepage_link}",
		"sources": "${sources_link}",
		"issues": "${issues_link}"
	},
	"license": "${mod_license}",
	"icon": "assets/${mod_id}/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"starman.aspengrove.AspenGrove"
		],
		"client": [
			"starman.aspengrove.classes.client.AspenGroveClient"
		]
	},
	"depends": {
		"fabricloader": ">=${min_fabric_loader_version}",
		"minecraft": "${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*",
		"biolith": "*"
	}
}